# 키움 REST API 포털(openapi.kiwoom.com)에서 발급받은 값
# (계좌평가/보유종목 조회 API는 앱키에 연결된 계좌를 자동으로 사용하므로 계좌번호는 별도로 필요 없습니다)
KIWOOM_APP_KEY=
KIWOOM_APP_SECRET=

# 실전투자: false, 모의투자: true
KIWOOM_IS_MOCK=false

# 금융감독원 DART OpenAPI (opendart.fss.or.kr) — 공시·재무제표·배당
DART_API_KEY=

# 네이버 검색 API — NAVER API Hub(ncloud)에서 발급. 뉴스 검색용
# 주의: 구 openapi.naver.com이 아니라 naverapihub.apigw.ntruss.com 입니다
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Claude API (console.anthropic.com) — 데일리 리포트 요약용
# 없으면 요약 없이 원본 데이터만으로 리포트가 나갑니다 (서버는 정상 동작)
ANTHROPIC_API_KEY=
# 요약 모델. 비용 아끼려면 claude-haiku-4-5-20251001
CLAUDE_MODEL=claude-sonnet-5

# 텔레그램 알림 봇 — @BotFather로 발급
TELEGRAM_BOT_TOKEN=
# 기본 대화방 — 아래 채널별 ID를 안 채우면 전부 여기로 간다
TELEGRAM_CHAT_ID=
# 채널을 나누려면: 그룹 3개를 만들고 봇을 각각 초대한 뒤,
# `node scripts/telegram-chats.mjs` 로 chat_id를 확인해서 채운다.
# 그룹 ID는 -100 으로 시작한다.
TELEGRAM_CHAT_ID_REPORT=
TELEGRAM_CHAT_ID_SIGNAL=
TELEGRAM_CHAT_ID_LOG=
# 구독 채널 정리를 받을 방
TELEGRAM_CHAT_ID_CHANNEL=

# 실시간 이중 연결 롤백 스위치 (기본: 켬)
# 웹소켓을 두 개 열어 구독 정원을 190→380 으로 늘린다 (거래대금 96~190위까지
# 체결(0B) 실시간). 장중에 이상이 보이면 아래 한 줄을 넣고 재시작 — 한 연결로 돌아간다.
# REALTIME_DUAL=0

# 알림 딥링크의 바탕 주소 (선택) — 채우면 알림 속 종목명이
# 개별종목분석으로 바로 가는 링크가 된다. 예: http://192.168.0.10:4000
# 폰에서 눌러야 하니 localhost 말고 미니PC의 LAN 주소(또는 터널 주소)를 넣을 것.
HTS_WEB_URL=

# ── 구독 채널 수집 (MTProto) ──────────────────────────────
# 봇 API로는 내가 구독 중인 채널을 읽을 수 없다. 사용자 계정 로그인이 필요하다.
#   1. https://my.telegram.org → API development tools 에서 발급
#   2. cd server && node scripts/telegram-login.mjs 로 세션 생성
#
# ⚠ 세션은 **한 대에서만** 써야 한다. 두 대에서 동시에 접속하면
#   AUTH_KEY_DUPLICATED 로 세션이 무효화된다.
#   최종 운영은 미니PC이므로 **로그인도 미니PC에서** 할 것.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=

# 네이버 메일 발송 (데일리 리포트)
# ⚠ 네이버 메일 설정에서 POP3/SMTP "사용함"을 먼저 켜야 합니다
NAVER_MAIL_USER=
NAVER_MAIL_PASS=
MAIL_TO=

# 이 서버가 뜨는 포트. 미니PC에서는 이 포트 하나로 웹 화면까지 서빙합니다
PORT=4000

# ── 이미지 분석 (선택) ────────────────────────────────
# 캘린더 이미지 인식 등에 쓴다. **키가 있는 것 중 싼 것부터** 자동으로 고르고,
# 실패하면 다음 제공자로 넘어간다. 셋 다 없으면 이미지 기능만 비활성화된다.
#
#   우선순위      1) Gemini   2) OpenAI   3) Claude
#   이미지 1장    ~$0.0015    ~$0.0005    ~$0.004
#
# Gemini: https://aistudio.google.com/apikey  (무료 한도가 넉넉하다)
GEMINI_API_KEY=
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# 모델을 바꾸고 싶을 때만 (비우면 기본값: gemini-2.5-flash / gpt-4o-mini / claude-haiku-4-5)
GEMINI_VISION_MODEL=
OPENAI_VISION_MODEL=
ANTHROPIC_VISION_MODEL=

# ── 수출입 무역통계 (선택) ────────────────────────────
# 관세청 수출입 통계. 반도체·자동차 수출 증감률은 섹터 실적의 선행 지표다.
# 10일 단위 잠정치라 월 3회 갱신 — 분기 실적보다 훨씬 빠르다.
#
# 발급: https://www.data.go.kr 가입 후 아래 API 활용신청 (개발계정 자동승인, 일 1만건)
#   관세청_수입 주요품목별 10일 단위 잠정치 통계  (데이터셋 15157901)
#   관세청_품목별 수출입실적(GW)                  (데이터셋 15101609)
#
# ⚠ **Encoding 키가 아니라 Decoding 키를 넣을 것.**
#   인코딩 키를 넣으면 이중 인코딩돼서 SERVICE_KEY_IS_NOT_REGISTERED_ERROR 가 난다.
#   자세한 절차: docs/수출입API_설정가이드.md
DATA_GO_KR_KEY=

# ── 외부 접속 (터널을 쓸 때만) ──────────────────────────────
# 비워 두면 예전처럼 전면 허용이라 집 안 사용은 그대로 돌아간다.
# 밖으로 열 때는 **반드시** 채울 것 — 안 채우면 내가 방문한 아무 웹사이트나
# 이 API 를 불러 계좌·관심종목을 읽어 갈 수 있다.
# ALLOWED_ORIGINS=https://hts.example.com
#
# 터널(cloudflared)은 같은 기계 안에서 로컬로 붙으므로 밖에 귀를 열 필요가 없다.
# 좁혀 두면 공유기 안의 다른 기기에도 안 보인다.
# BIND_HOST=127.0.0.1
