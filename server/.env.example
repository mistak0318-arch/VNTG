# 키움 REST API 포털(openapi.kiwoom.com)에서 발급받은 값
# (계좌평가/보유종목 조회 API는 앱키에 연결된 계좌를 자동으로 사용하므로 계좌번호는 별도로 필요 없습니다)
KIWOOM_APP_KEY=
KIWOOM_APP_SECRET=

# 실전투자: false, 모의투자: true
KIWOOM_IS_MOCK=false

# 금융감독원 DART OpenAPI (opendart.fss.or.kr) — 공시·재무제표·배당
DART_API_KEY=

# 네이버 검색 API — NAVER API Hub(ncloud)에서 발급. 뉴스 검색용
# 주의: 구 openapi.naver.com이 아니라 naverapihub.apigw.ntruss.com 입니다
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Claude API (console.anthropic.com) — 데일리 리포트 요약용
# 없으면 요약 없이 원본 데이터만으로 리포트가 나갑니다 (서버는 정상 동작)
ANTHROPIC_API_KEY=
# 요약 모델. 비용 아끼려면 claude-haiku-4-5-20251001
CLAUDE_MODEL=claude-sonnet-5

# 텔레그램 알림 봇 — @BotFather로 발급
TELEGRAM_BOT_TOKEN=
# 기본 대화방 — 아래 채널별 ID를 안 채우면 전부 여기로 간다
TELEGRAM_CHAT_ID=
# 채널을 나누려면: 그룹 3개를 만들고 봇을 각각 초대한 뒤,
# `node scripts/telegram-chats.mjs` 로 chat_id를 확인해서 채운다.
# 그룹 ID는 -100 으로 시작한다.
TELEGRAM_CHAT_ID_REPORT=
TELEGRAM_CHAT_ID_SIGNAL=
TELEGRAM_CHAT_ID_LOG=

# 네이버 메일 발송 (데일리 리포트)
# ⚠ 네이버 메일 설정에서 POP3/SMTP "사용함"을 먼저 켜야 합니다
NAVER_MAIL_USER=
NAVER_MAIL_PASS=
MAIL_TO=

# 이 서버가 뜨는 포트. 미니PC에서는 이 포트 하나로 웹 화면까지 서빙합니다
PORT=4000
