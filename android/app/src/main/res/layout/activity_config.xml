<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#171C24">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VNTG 위젯 설정"
            android:textColor="#E7EBF0"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView style="@style/CfgLabel"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="서버 주소" />
        <EditText
            android:id="@+id/baseUrl"
            style="@style/CfgInput"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="https://vntgts.com"
            android:inputType="textUri" />

        <TextView style="@style/CfgLabel"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Cloudflare Access Client Id (비우면 헤더 없이)" />
        <EditText
            android:id="@+id/cfId"
            style="@style/CfgInput"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:inputType="text" />

        <TextView style="@style/CfgLabel"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Cloudflare Access Client Secret" />
        <EditText
            android:id="@+id/cfSecret"
            style="@style/CfgInput"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:inputType="textPassword" />

        <TextView style="@style/CfgLabel"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="관심종목 그룹" />
        <Spinner
            android:id="@+id/groupSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <Button
            android:id="@+id/save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="저장하고 위젯 갱신" />

        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="#8B96A5" />
    </LinearLayout>
</ScrollView>
