node_modules/
dist/
.env
*.log

# TypeScript 증분 빌드 캐시.
# 기기마다 내용이 달라지는 산출물이라 추적하면 pull 할 때마다 충돌한다.
*.tsbuildinfo

# 로컬 데이터 (기기마다 다름 — 수집 이력, 캐시, 사용량)
#
# 디렉터리 자체를 제외하면 git이 안으로 들어가지 않아 아래 `!` 되살리기가 안 먹는다.
# 그래서 "안의 것 전부"를 제외하고 필요한 파일만 되살린다.
server/data/*
!server/data/.gitkeep

# "내가 만든 것"은 기기 상태가 아니라 자산이라 기기를 따라다녀야 한다.
# 메인PC에서 만든 테마가 미니PC에 없으면 처음부터 다시 만들어야 한다.
# 이쪽은 **이 PC에서 만들어 미니PC로 보내는 것**이다. 한 번 짜서 내려보내면 끝이라
# 양쪽이 동시에 고칠 일이 없다.
!server/data/customThemes.json
!server/data/usWatchlist.json
!server/data/calendar.json
!server/data/stockNotes.json

# 아래는 **미니PC가 쓰면서 쌓이는 것**이라 추적하지 않는다.
#
# 처음엔 "자산이니 기기를 따라다녀야 한다"고 추적에 넣었는데, 그게 틀렸다.
# 양쪽 PC 가 같은 파일을 쓰니 pull 할 때마다 충돌한다 —
# 실제로 미니PC 에서 신호등 찾기로 33종목을 담은 뒤 pull 이 막혔다.
#
# 자산인 건 맞지만 **쓰는 곳이 하나**라는 게 더 중요하다. 미니PC 가 상시 운영 기기이므로
# 거기를 유일한 주체로 두고, 이 PC 는 개발용으로만 쓴다.
# server/data/watchlist.json
# server/data/watchGroups.json
# server/data/journal.json
# server/data/paperTrades.json

# 미니PC 로컬 백업 — 저장소에 올릴 것이 아니다
data-backup/
server/data/*.backup-*.json
server/data/*.mine.json
